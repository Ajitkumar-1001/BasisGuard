# Exactly one of: live | fixture | replay
BASISGUARD_MODE=fixture
# fixture/test must point at basisguard_test; live dev uses basisguard_dev
DATABASE_URL=postgres://basisguard:basisguard@127.0.0.1:5432/basisguard_test
# Absolute path recommended (apps run with their own cwd)
BASISGUARD_RATE_CARD=/absolute/path/to/config/rate-cards/parallel-2026-10-17.json
HOSTED=false
NEXT_TELEMETRY_DISABLED=1
# live mode only — never commit real values
PARALLEL_API_KEY=
OPENAI_API_KEY=
